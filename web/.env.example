BID_API_BASE_URL=http://127.0.0.1:8000
# Default: browser calls /api through the web server, including Tailscale access.
NEXT_PUBLIC_API_MODE=proxy
# Used only when NEXT_PUBLIC_API_MODE=direct:
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Optional invited public demo. Start-Bid3PublicDemo.ps1 creates private secrets.
# Keep these server-only: never use NEXT_PUBLIC_ for an invitation password/key.
BID3_PUBLIC_DEMO=0
# Only explicit 0 opens the landing page without an invitation. BID3 login still applies.
BID3_DEMO_REQUIRE_INVITE=1
BID3_DEMO_PASSWORD=
BID3_DEMO_SIGNING_KEY=
BID3_DEMO_ORIGIN=
