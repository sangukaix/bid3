G2B_API_KEY=
OPENAI_API_KEY=
PROPOSAL_MODEL=gpt-5.6-sol
REQUIREMENT_MODEL=gpt-5.6-terra
COMPANY_KNOWLEDGE_MODEL=gpt-4o-mini

# Per-feature settings. Each PC/project selects its own model.
CHAT_PROVIDER=openai
ANALYSIS_PROVIDER=openai
COMPANY_KNOWLEDGE_PROVIDER=openai
REQUIREMENT_PROVIDER=openai
PROPOSAL_PROVIDER=openai
QUANTITATIVE_PROVIDER=openai
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen3:14b
CHAT_LOCAL_MODEL=qwen3:14b
LOCAL_LLM_CONTEXT=16384
LOCAL_LLM_TIMEOUT=180
OPENAI_TIMEOUT=180
OPENAI_MAX_RETRIES=1
WEB_SEARCH_MODEL=gpt-5.6-sol
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# vector uses OpenAI embeddings; keyword uses local text search.
RAG_SEARCH_MODE=vector
